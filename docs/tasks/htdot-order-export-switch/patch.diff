+package com.hgihtorque.ordercenter.reporting.interfaces.mcp;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+/** Deployment switch for fixed-revision daily report export; defaults on so existing deployments are unchanged. */
+@Component
+public class ReportExportSwitch {
+ private final boolean enabled;
+ public ReportExportSwitch(@Value("${ordercenter.report.export.enabled:true}") boolean enabled){this.enabled=enabled;}
+ public boolean enabled(){return enabled;}
+}
