@@ -0,0 +1,73 @@
+package com.hgihtorque.ordercenter.workflow;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.hgihtorque.ordercenter.integration.application.McpBusinessResult;
+import com.hgihtorque.ordercenter.order.application.BusinessCaller;
+import com.hgihtorque.ordercenter.order.interfaces.mcp.*;
+import com.hgihtorque.ordercenter.reporting.application.DailyReportExportService;
+import com.hgihtorque.ordercenter.reporting.interfaces.mcp.DailyExportTool;
+import com.hgihtorque.ordercenter.reporting.interfaces.mcp.ReportExportSwitch;
+import com.hgihtorque.ordercenter.workflow.interfaces.mcp.WorkflowToolRegistry;
+import org.junit.jupiter.api.*;
+import org.springframework.boot.test.context.runner.ApplicationContextRunner;
+import java.util.*;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+@Tag("TEST")
+class DailyExportSwitchTest {
+ private final ObjectMapper json=new ObjectMapper();
+ private final BusinessCaller caller=new BusinessCaller("T","A",Set.of("order:read"));
+ private com.fasterxml.jackson.databind.node.ObjectNode args(String format){
+  var args=json.createObjectNode().put("instanceId","O").put("revisionId","R");
+  return format==null?args:args.put("format",format);
+ }
+ @Test void propertySwitchDefaultsOnAndHonorsExplicitFalse(){
+  new ApplicationContextRunner().withUserConfiguration(ReportExportSwitch.class)
+   .run(context->assertTrue(context.getBean(ReportExportSwitch.class).enabled()));
+  new ApplicationContextRunner().withUserConfiguration(ReportExportSwitch.class)
+   .withPropertyValues("ordercenter.report.export.enabled=false")
+   .run(context->assertFalse(context.getBean(ReportExportSwitch.class).enabled()));
+ }
+ @Test void enabledToolDelegatesToTheExistingExporter()throws Exception{
+  var exports=mock(DailyReportExportService.class);
+  var export=new DailyReportExportService.Export("daily-O-R.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","sha",3,"QQ==");
+  when(exports.export(caller,"O","R","xlsx")).thenReturn(export);
+  var result=new DailyExportTool(exports,new ReportExportSwitch(true)).call(caller,args("xlsx"));
+  assertEquals("daily-O-R.xlsx",result.path("filename").asText());
+  verify(exports).export(caller,"O","R","xlsx");
+ }
+ @Test void disabledToolRejectsWithStableCodeAndNeverCallsTheExporter(){
+  var exports=mock(DailyReportExportService.class);
+  var failure=assertThrows(IllegalStateException.class,()->new DailyExportTool(exports,new ReportExportSwitch(false)).call(caller,args("xlsx")));
+  assertEquals("REPORT_EXPORT_DISABLED",failure.getMessage());
+  verifyNoInteractions(exports);
+  assertEquals("日报导出功能已关闭（REPORT_EXPORT_DISABLED），请联系管理员开启",McpBusinessResult.stateMessage(failure));
+ }
+ @Test void scopeIsCheckedBeforeTheSwitch(){
+  var failure=assertThrows(SecurityException.class,()->new DailyExportTool(mock(DailyReportExportService.class),new ReportExportSwitch(false)).call(new BusinessCaller("T","A",Set.of()),args("xlsx")));
+  assertEquals("ORDER_READ_FORBIDDEN",failure.getMessage());
+ }
+ @Test void invalidArgumentsKeepTheirExistingCodesWhileEnabled()throws Exception{
+  var tool=new DailyExportTool(mock(DailyReportExportService.class),new ReportExportSwitch(true));
+  assertEquals("INVALID_REPORT_EXPORT",assertThrows(IllegalArgumentException.class,()->tool.call(caller,json.createObjectNode().put("instanceId","O"))).getMessage());
+  assertEquals("INVALID_REPORT_EXPORT",assertThrows(IllegalArgumentException.class,()->tool.call(caller,args("xlsx").put("tenant","other"))).getMessage());
+  assertEquals("INVALID_REPORT_FORMAT",assertThrows(IllegalArgumentException.class,()->tool.call(caller,args(null).put("format",1))).getMessage());
+ }
+ @Test void browserCapabilityCarriesDisabledFlagWhileMcpStillAdvertisesTheTool(){
+  var disabled=new DailyExportTool(mock(DailyReportExportService.class),new ReportExportSwitch(false));
+  var capability=find(registry(disabled).listApi(caller),"production_daily_export");
+  assertNotNull(capability);assertFalse(capability.path("enabled").asBoolean(true));
+  assertNotNull(find(registry(disabled).list(caller),"production_daily_export"));
+  var enabled=find(registry(new DailyExportTool(mock(DailyReportExportService.class),new ReportExportSwitch(true))).listApi(caller),"production_daily_export");
+  assertNotNull(enabled);assertTrue(enabled.path("enabled").isMissingNode());
+ }
+ private WorkflowToolRegistry registry(DailyExportTool export){
+  var registry=new WorkflowToolRegistry(mock(OrderStatusTool.class),mock(ApprovalPreviewTool.class),mock(DemandBeginTool.class),mock(DemandAttachmentTool.class),mock(DemandCompleteTool.class),mock(DailyBeginTool.class),mock(DailyReportTool.class),mock(DailyResubmitTool.class),mock(ProductionAggregateTool.class),mock(OriginalAttachmentReadTool.class));
+  registry.configureDailyExport(export);
+  return registry;
+ }
+ private JsonNode find(JsonNode tools,String name){
+  for(var tool:tools)if(name.equals(tool.path("name").asText()))return tool;
+  return null;
+ }
+}
