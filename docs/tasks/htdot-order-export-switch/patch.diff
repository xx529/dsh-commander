diff --git a/order-center-tests/workflow/src/test/java/com/hgihtorque/ordercenter/workflow/DailyExportSwitchTest.java b/order-center-tests/workflow/src/test/java/com/hgihtorque/ordercenter/workflow/DailyExportSwitchTest.java
