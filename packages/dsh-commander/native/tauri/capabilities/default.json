{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the commander shell windows (ball + panel + bubble): core events, window dragging, and the loopback Host page origin.",
  "windows": [
    "main",
    "panel",
    "bubble",
    "session-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-set-mode",
    "allow-set-bubble",
    "allow-set-quick-input",
    "allow-set-ball-unread",
    "allow-open-external",
    "allow-quit",
    "allow-open-session-window"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
