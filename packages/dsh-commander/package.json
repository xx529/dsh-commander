{
  "name": "dsh-commander",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Commander plugin for DeepSeek Harness: dispatch tasks to workspaces and sessions from a commander conversation.",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "native/dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "prepare": "node scripts/prepare-install.mjs",
    "build": "pnpm run build:host && pnpm run build:client && pnpm run build:window",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown && node ../../tools/dev/wrap-client.mjs dsh-commander lib/client.cjs lib/client.js",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts tests/client/*.test.ts",
    "build:spike": "bash ../../tools/dev/spike-build.sh",
    "build:window": "tsdown --config tsdown.window.config.ts && mv lib/window.iife.js lib/window.js",
    "build:native": "bash native/build.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
}
